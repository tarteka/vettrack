<!DOCTYPE html>
<html lang="es-ES">
<head>
    <meta charset="utf-8">
    <title>Factura {{ invoice.invoiceNumber }}</title>
</head>
<body style="
    font-family: Arial, sans-serif;
    line-height: 1.6;
    color: #333;
    font-size: 16px;
">
<div style="max-width: 600px; margin: 0 auto;">

    <h2 style="color: #2563eb;">
        Factura {{ invoice.invoiceNumber }}
    </h2>

    <p>
        Estimado/a <strong>{{ invoice.user.fullName }}</strong>,
    </p>

    <p>
        Le enviamos su factura correspondiente a la visita realizada el día
        <strong>{{ invoice.invoiceDate|date('d/m/Y') }}</strong>.
    </p>

    <div style="background: #f8fafc; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <strong>Total factura:</strong><br>
        <span style="font-size: 18px;">
            {{ invoice.totalAmount|number_format(2, ',', '.') }} €
        </span>
    </div>

    {% if invoice.notes %}
        <p>
            <strong>Notas:</strong><br>
            {{ invoice.notes }}
        </p>
    {% endif %}

    <p>
        La factura completa se adjunta en formato PDF.
    </p>

    <hr style="margin: 40px 0;">

    <p>
        Un saludo,<br>
        <strong>{{ clinic.clinicName }}</strong><br>
        <a href="mailto:{{ clinic.email }}">{{ clinic.email }}</a>
    </p>

</div>
</body>
</html>
